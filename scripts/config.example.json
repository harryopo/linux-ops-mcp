{
  "host": "your.server.example.com",
  "port": 22,
  "username": "deploy",

  "auth_method": "key",
  "key_path": "~/.ssh/id_ed25519",
  "key_passphrase_env": "LINUX_OPS_KEY_PASSPHRASE",

  "password_env": "LINUX_OPS_PASSWORD",

  "host_key_policy": "strict",

  "connect_timeout": 10,
  "command_timeout": 30,

  "ssh_config_host": "",
  "ssh_config_file": "~/.ssh/config"
}
